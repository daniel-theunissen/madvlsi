close all;
data = import_ngspice("VI_input.txt")
Iref = data.i_v_x1_vib_(53);
Vin_p = data.v_vin_p_;
Vin_n = 0.5;
R = 100e3;
Ir = (Vin_p - Vin_n) ./ R;

Iout_p = Iref + Ir;
Iout_n = Iref - Ir;

figure;
plot(Vin_p, Iout_n, "m--"); hold on
plot(Vin_p, Iout_p, "c--")
plot(Vin_p, data.i_viout_n_, "m.")
plot(Vin_p, data.i_viout_p_, "c.")
xlabel("V+ (V)")
ylabel("I (A)")
title("Iout+, Iout- @ V- = 0.5V")
legend("Iout- (theory)", "Iout+ (theory)", "Iout- (sim)", "Iout+ (sim)")

figure;
plot(Vin_p, data.i_v_x1_vib_, "r.")
xlabel("V+ (V)")
ylabel("Iref (A)")
title("Diff Pair Reference Current")
legend("Ib thru diff pair", location="s")